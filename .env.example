# Values interpolated into docker-compose.yml (NOT the backend's runtime env,
# which lives in backend/.env). Copy to .env and fill in.

# GitHub OAuth app client id — also passed to the dashboard so the
# "Continue with GitHub" button renders.
GITHUB_CLIENT_ID=

# Data-tier credentials. Required: compose fails fast if unset, so a stack
# can never come up with a blank or default database/broker password.
# Generate: python -c "import secrets;print(secrets.token_urlsafe(24))"
POSTGRES_PASSWORD=
REDIS_PASSWORD=
