{
  "uid": "aegis-overview",
  "title": "Aegis Overview",
  "tags": ["aegis"],
  "timezone": "browser",
  "schemaVersion": 39,
  "_comment": "Bump `version` on every edit — Grafana's file provisioner ignores a changed dashboard whose version did not increase.",
  "version": 3,
  "refresh": "30s",
  "time": { "from": "now-6h", "to": "now" },
  "templating": {
    "list": [
      {
        "name": "container",
        "label": "Container",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "query": "label_values(container_cpu_usage_seconds_total{name!=\"\"}, name)",
        "refresh": 2,
        "includeAll": true,
        "allValue": ".+",
        "multi": true,
        "current": { "text": "All", "value": "$__all" }
      }
    ]
  },
  "panels": [
    { "id": 100, "type": "row", "title": "Service health", "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 }, "collapsed": false, "panels": [] },
    {
      "id": 1,
      "title": "API up",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 4, "w": 3, "x": 0, "y": 1 },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "type": "value", "options": { "0": { "text": "DOWN", "color": "red" }, "1": { "text": "UP", "color": "green" } } }
          ],
          "thresholds": { "mode": "absolute", "steps": [{ "color": "red", "value": null }, { "color": "green", "value": 1 }] }
        },
        "overrides": []
      },
      "targets": [{ "refId": "A", "expr": "up{job=\"aegis-api\"}" }]
    },
    {
      "id": 2,
      "title": "Requests / s",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 4, "w": 3, "x": 3, "y": 1 },
      "fieldConfig": { "defaults": { "unit": "reqps", "decimals": 2 }, "overrides": [] },
      "targets": [{ "refId": "A", "expr": "sum(rate(http_requests_total[5m]))" }]
    },
    {
      "id": 3,
      "title": "5xx ratio",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 4, "w": 3, "x": 6, "y": 1 },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 2,
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "orange", "value": 0.01 }, { "color": "red", "value": 0.05 }] }
        },
        "overrides": []
      },
      "targets": [
        { "refId": "A", "expr": "sum(rate(http_requests_total{status=~\"5.*\"}[5m])) / clamp_min(sum(rate(http_requests_total[5m])), 0.001)" }
      ]
    },
    {
      "id": 4,
      "title": "p95 latency",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 4, "w": 3, "x": 9, "y": 1 },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 3,
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "orange", "value": 0.5 }, { "color": "red", "value": 2 }] }
        },
        "overrides": []
      },
      "targets": [
        { "refId": "A", "expr": "histogram_quantile(0.95, sum(rate(http_request_duration_highr_seconds_bucket[5m])) by (le))" }
      ]
    },
    {
      "id": 5,
      "title": "Workers up",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 4, "w": 3, "x": 12, "y": 1 },
      "fieldConfig": {
        "defaults": { "thresholds": { "mode": "absolute", "steps": [{ "color": "red", "value": null }, { "color": "green", "value": 1 }] } },
        "overrides": []
      },
      "targets": [{ "refId": "A", "expr": "sum(celery_worker_up)" }]
    },
    {
      "id": 6,
      "title": "Scans running",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 4, "w": 3, "x": 15, "y": 1 },
      "targets": [{ "refId": "A", "expr": "sum(celery_worker_tasks_active)" }]
    },
    {
      "id": 7,
      "title": "Queue backlog",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 4, "w": 3, "x": 18, "y": 1 },
      "description": "Tasks waiting on the broker. A backlog that never drains means the worker pool is too small for the scan volume.",
      "fieldConfig": {
        "defaults": { "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "orange", "value": 5 }, { "color": "red", "value": 25 }] } },
        "overrides": []
      },
      "targets": [{ "refId": "A", "expr": "sum(celery_queue_length)" }]
    },
    {
      "id": 8,
      "title": "Failed tasks (1h)",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 4, "w": 3, "x": 21, "y": 1 },
      "fieldConfig": {
        "defaults": { "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "red", "value": 1 }] } },
        "overrides": []
      },
      "targets": [{ "refId": "A", "expr": "sum(increase(celery_task_failed_total[1h]))" }]
    },

    { "id": 101, "type": "row", "title": "API", "gridPos": { "h": 1, "w": 24, "x": 0, "y": 5 }, "collapsed": false, "panels": [] },
    {
      "id": 10,
      "title": "Request rate by endpoint",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 6 },
      "fieldConfig": { "defaults": { "unit": "reqps", "custom": { "fillOpacity": 10, "stacking": { "mode": "normal" } } }, "overrides": [] },
      "targets": [
        { "refId": "A", "expr": "topk(10, sum by (handler) (rate(http_requests_total[5m])))", "legendFormat": "{{handler}}" }
      ]
    },
    {
      "id": 11,
      "title": "Latency percentiles",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 6 },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [
        { "refId": "A", "expr": "histogram_quantile(0.50, sum(rate(http_request_duration_highr_seconds_bucket[5m])) by (le))", "legendFormat": "p50" },
        { "refId": "B", "expr": "histogram_quantile(0.95, sum(rate(http_request_duration_highr_seconds_bucket[5m])) by (le))", "legendFormat": "p95" },
        { "refId": "C", "expr": "histogram_quantile(0.99, sum(rate(http_request_duration_highr_seconds_bucket[5m])) by (le))", "legendFormat": "p99" }
      ]
    },
    {
      "id": 12,
      "title": "Responses by status class",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 14 },
      "description": "429s are the rate limiter doing its job; a sustained climb means a client is hammering auth.",
      "fieldConfig": { "defaults": { "unit": "reqps", "custom": { "fillOpacity": 20, "stacking": { "mode": "normal" } } }, "overrides": [] },
      "targets": [
        { "refId": "A", "expr": "sum by (status) (rate(http_requests_total[5m]))", "legendFormat": "{{status}}" }
      ]
    },
    {
      "id": 13,
      "title": "Slowest endpoints (p95)",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 14 },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [
        { "refId": "A", "expr": "topk(5, histogram_quantile(0.95, sum by (le, handler) (rate(http_request_duration_seconds_bucket[5m]))))", "legendFormat": "{{handler}}" }
      ]
    },

    { "id": 102, "type": "row", "title": "Scans", "gridPos": { "h": 1, "w": 24, "x": 0, "y": 22 }, "collapsed": false, "panels": [] },
    {
      "id": 20,
      "title": "Task throughput",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 23 },
      "fieldConfig": { "defaults": { "unit": "ops" }, "overrides": [] },
      "targets": [
        { "refId": "A", "expr": "sum(rate(celery_task_succeeded_total[5m]))", "legendFormat": "succeeded" },
        { "refId": "B", "expr": "sum(rate(celery_task_failed_total[5m]))", "legendFormat": "failed" },
        { "refId": "C", "expr": "sum(rate(celery_task_retried_total[5m]))", "legendFormat": "retried" },
        { "refId": "D", "expr": "sum(rate(celery_task_received_total[5m]))", "legendFormat": "received" }
      ]
    },
    {
      "id": 21,
      "title": "Scan duration",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 23 },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [
        { "refId": "A", "expr": "histogram_quantile(0.50, sum by (le) (rate(celery_task_runtime_bucket[30m])))", "legendFormat": "p50" },
        { "refId": "B", "expr": "histogram_quantile(0.95, sum by (le) (rate(celery_task_runtime_bucket[30m])))", "legendFormat": "p95" }
      ]
    },
    {
      "id": 22,
      "title": "Queue length by queue",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 31 },
      "targets": [
        { "refId": "A", "expr": "sum by (queue_name) (celery_queue_length)", "legendFormat": "{{queue_name}}" }
      ]
    },
    {
      "id": 23,
      "title": "Failures by task",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 31 },
      "fieldConfig": { "defaults": { "unit": "ops", "custom": { "fillOpacity": 20, "stacking": { "mode": "normal" } } }, "overrides": [] },
      "targets": [
        { "refId": "A", "expr": "sum by (name) (rate(celery_task_failed_total[15m]))", "legendFormat": "{{name}}" }
      ]
    },

    { "id": 103, "type": "row", "title": "System resources", "gridPos": { "h": 1, "w": 24, "x": 0, "y": 39 }, "collapsed": false, "panels": [] },
    {
      "id": 30,
      "title": "CPU cores used per container",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 40 },
      "description": "Sandbox containers spawned by a scan appear here as short-lived series.",
      "fieldConfig": { "defaults": { "unit": "none", "decimals": 2, "custom": { "fillOpacity": 10 } }, "overrides": [] },
      "targets": [
        { "refId": "A", "expr": "sum by (name) (rate(container_cpu_usage_seconds_total{name=~\"$container\"}[5m]))", "legendFormat": "{{name}}" }
      ]
    },
    {
      "id": 31,
      "title": "Memory working set per container",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 40 },
      "fieldConfig": { "defaults": { "unit": "bytes", "custom": { "fillOpacity": 10 } }, "overrides": [] },
      "targets": [
        { "refId": "A", "expr": "sum by (name) (container_memory_working_set_bytes{name=~\"$container\"})", "legendFormat": "{{name}}" }
      ]
    },
    {
      "id": 32,
      "title": "Network I/O per container",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 48 },
      "fieldConfig": { "defaults": { "unit": "Bps" }, "overrides": [] },
      "targets": [
        { "refId": "A", "expr": "sum by (name) (rate(container_network_receive_bytes_total{name=~\"$container\"}[5m]))", "legendFormat": "{{name}} rx" },
        { "refId": "B", "expr": "-sum by (name) (rate(container_network_transmit_bytes_total{name=~\"$container\"}[5m]))", "legendFormat": "{{name}} tx" }
      ]
    },
    {
      "id": 33,
      "title": "Disk I/O per container",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 48 },
      "fieldConfig": { "defaults": { "unit": "Bps" }, "overrides": [] },
      "targets": [
        { "refId": "A", "expr": "sum by (name) (rate(container_fs_reads_bytes_total{name=~\"$container\"}[5m]))", "legendFormat": "{{name}} read" },
        { "refId": "B", "expr": "-sum by (name) (rate(container_fs_writes_bytes_total{name=~\"$container\"}[5m]))", "legendFormat": "{{name}} write" }
      ]
    },
    {
      "id": 34,
      "title": "Filesystem used",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 56 },
      "description": "Scan checkouts and Strix run state live on the shared scandata volume — this is the disk that fills first.",
      "fieldConfig": { "defaults": { "unit": "bytes" }, "overrides": [] },
      "targets": [
        { "refId": "A", "expr": "sum by (device) (container_fs_usage_bytes{id=\"/\", device=~\"/dev/(sd|nvme|vd|xvd)[a-z0-9]*\"})", "legendFormat": "{{device}} used" },
        { "refId": "B", "expr": "sum by (device) (container_fs_limit_bytes{id=\"/\", device=~\"/dev/(sd|nvme|vd|xvd)[a-z0-9]*\"})", "legendFormat": "{{device}} total" }
      ]
    },
    {
      "id": 35,
      "title": "API process (RSS / CPU / fds)",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 56 },
      "targets": [
        { "refId": "A", "expr": "process_resident_memory_bytes{job=\"aegis-api\"}", "legendFormat": "rss bytes" },
        { "refId": "B", "expr": "rate(process_cpu_seconds_total{job=\"aegis-api\"}[5m])", "legendFormat": "cpu cores" },
        { "refId": "C", "expr": "process_open_fds{job=\"aegis-api\"}", "legendFormat": "open fds" }
      ]
    },

    { "id": 104, "type": "row", "title": "PostgreSQL", "gridPos": { "h": 1, "w": 24, "x": 0, "y": 64 }, "collapsed": false, "panels": [] },
    {
      "id": 40,
      "title": "Connections vs max",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 65 },
      "description": "Connection exhaustion is the usual way this stack falls over — every API and worker process holds a pool.",
      "targets": [
        { "refId": "A", "expr": "sum(pg_stat_database_numbackends)", "legendFormat": "in use" },
        { "refId": "B", "expr": "pg_settings_max_connections", "legendFormat": "max" }
      ]
    },
    {
      "id": 41,
      "title": "Transactions / s",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 65 },
      "fieldConfig": { "defaults": { "unit": "ops" }, "overrides": [] },
      "targets": [
        { "refId": "A", "expr": "sum(rate(pg_stat_database_xact_commit{datname=\"aegis\"}[5m]))", "legendFormat": "commit" },
        { "refId": "B", "expr": "sum(rate(pg_stat_database_xact_rollback{datname=\"aegis\"}[5m]))", "legendFormat": "rollback" }
      ]
    },
    {
      "id": 42,
      "title": "Database size / cache hit ratio",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 65 },
      "targets": [
        { "refId": "A", "expr": "pg_database_size_bytes{datname=\"aegis\"}", "legendFormat": "size bytes" },
        { "refId": "B", "expr": "sum(rate(pg_stat_database_blks_hit{datname=\"aegis\"}[5m])) / clamp_min(sum(rate(pg_stat_database_blks_hit{datname=\"aegis\"}[5m]) + rate(pg_stat_database_blks_read{datname=\"aegis\"}[5m])), 0.001)", "legendFormat": "cache hit ratio" }
      ]
    }
  ]
}
