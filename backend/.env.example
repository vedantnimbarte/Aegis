# ---- Core ----
PROJECT_NAME=Aegis
ENVIRONMENT=development
DEBUG=true

# ---- Database ----
# Password must match POSTGRES_PASSWORD in the repo-root .env, which is what
# docker compose provisions the database with.
DATABASE_URL=postgresql+psycopg://aegis:CHANGE_ME@localhost:5432/aegis

# ---- Redis / Celery ----
# Password must match REDIS_PASSWORD in the repo-root .env.
REDIS_URL=redis://:CHANGE_ME@localhost:6379/0
# CELERY_BROKER_URL=        # defaults to REDIS_URL
# CELERY_RESULT_BACKEND=    # defaults to REDIS_URL

# ---- Auth / JWT ----
# Generate: python -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=change-me-to-a-long-random-string-min-32-chars
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=30
EMAIL_VERIFICATION_TOKEN_EXPIRE_HOURS=48

# ---- Email (SMTP) ----
# Leave SMTP_HOST blank in dev: emails (incl. password-reset links) are logged
# instead of sent.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_STARTTLS=true
EMAIL_FROM=Aegis Security <no-reply@aegis.security>

# ---- Encryption (AES-256-GCM for github_token at rest) ----
# Generate: python -c "import os,base64;print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
ENCRYPTION_KEY=change-me-url-safe-base64-of-32-bytes

# ---- GitHub OAuth ----
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_OAUTH_REDIRECT_URI=http://localhost:3001/auth/callback

# ---- GitHub App (CI/CD PR scanning) ----
GITHUB_APP_ID=
GITHUB_APP_SLUG=
# RSA private key: literal PEM, "\n"-escaped PEM, or base64-encoded PEM.
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_WEBHOOK_SECRET=
# Severities that fail the PR check run (comma-separated).
GITHUB_CHECK_FAIL_SEVERITIES=critical,high

# ---- Stripe ----
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Recurring Price IDs for the self-serve tiers (from the Stripe dashboard).
STRIPE_PRICE_STARTER=
STRIPE_PRICE_PRO=
# One-time price for the audit-ready compliance pentest report.
STRIPE_PRICE_COMPLIANCE_REPORT=
# Where Checkout / the billing portal return the user (the dashboard app).
DASHBOARD_URL=http://localhost:3001

# ---- LLM providers (forwarded to Strix) ----
# Model id in LiteLLM provider/model form, e.g. openai/gpt-4o or
# anthropic/claude-sonnet-4-6.
STRIX_LLM=openai/gpt-4o
# Strix authenticates with a single LLM_API_KEY. If blank, Aegis falls back to
# the provider key below that matches STRIX_LLM's prefix.
LLM_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# Optional: enables Strix's web-search capability.
PERPLEXITY_API_KEY=

# ---- Strix engine ----
# CLI executable (from the strix-agent package) and per-scan working dir.
STRIX_BIN=strix
STRIX_WORK_DIR=/tmp/aegis-scans
# Hard cap on a single scan's wall-clock (seconds); keep below Celery's limit.
STRIX_SCAN_TIMEOUT_SECONDS=3600
# Per-scan LLM spend cap in USD (defaults to 10.0; set blank/None to disable).
STRIX_MAX_BUDGET_USD=10
# STRIX_REASONING_EFFORT=medium
GIT_CLONE_TIMEOUT_SECONDS=300

# ---- Compliance reporting ----
# Printed on the attestation letter. The signer is a real person at the
# vendor; an unsigned letter is not what an auditor asked for.
COMPLIANCE_ATTESTOR_NAME=
COMPLIANCE_ATTESTOR_TITLE=Head of Security
COMPLIANCE_VENDOR_NAME=Aegis Security

# ---- Report sharing ----
# Share links always expire; these bound how long a user may choose.
REPORT_SHARE_DEFAULT_TTL_DAYS=14
REPORT_SHARE_MAX_TTL_DAYS=90

# ---- Attack-surface discovery ----
ASM_ENABLED=true
ASM_INTERVAL_HOURS=24
# Ceiling on assets recorded per sweep, so one wildcard DNS zone cannot fill
# the targets table.
ASM_MAX_ASSETS_PER_SWEEP=50
ASM_CRT_SH_URL=https://crt.sh
ASM_HTTP_TIMEOUT_SECONDS=10

# ---- Source hosts beyond GitHub ----
# Per-user tokens are entered in the dashboard; these are only the API roots
# (change them for self-hosted GitLab).
GITLAB_API_URL=https://gitlab.com/api/v4
BITBUCKET_API_URL=https://api.bitbucket.org/2.0

# ---- API spec inference ----
# Derive an OpenAPI description from a repo checkout so API testing has routes
# to exercise. Bounded so a huge monorepo cannot stall a scan.
API_SPEC_ENABLED=true
API_SPEC_MAX_FILES=2000
API_SPEC_MAX_FILE_BYTES=512000

# ---- CORS (comma-separated) ----
BACKEND_CORS_ORIGINS=http://localhost:3001
